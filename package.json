{
  "name": "amazon-carousel-updater",
  "version": "1.2.0",
  "description": "Local spreadsheet-to-Amazon-Slate desktop utility",
  "author": "MichaelBrandonFalk",
  "homepage": "https://michaelbrandonfalk.github.io/Amazon-Carousel-Updater/",
  "repository": "github:MichaelBrandonFalk/Amazon-Carousel-Updater",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test desktop/tests/*.test.cjs",
    "test:browser": "electron . --self-test",
    "dist:windows": "electron-builder --config desktop/electron-builder.cjs --win --x64 --publish never",
    "dist:linux": "electron-builder --config desktop/electron-builder.cjs --linux --x64 --publish never"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  }
}
